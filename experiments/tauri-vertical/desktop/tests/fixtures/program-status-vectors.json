     "kind": "state",
     "state": "idle",
     "at": 20
    }
   ]
  },
  {
   "name": "invalid utf-8 inside the payload is skipped",
   "note": "",
   "input": "G103NTAxO3N0YXRlPXdvcmtpbmc6dGl0bGU9//4H",
   "expect": [
    {
