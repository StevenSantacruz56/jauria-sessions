{
 "version": 1,
 "description": "Shared OSC 7501 / BEL / OSC 9 / OSC 777 vectors. 'payloads' are inputs to parseProgramStatus (expect: state, 'clear' or null). 'streams' are raw PTY bytes (base64); every event lists the byte offset ('at') of the byte that completes it. Consumers must produce the same events for the whole input, for every two-piece cut and byte by byte. The runner consumes this file in runner/src/agent_signals.rs.",
 "payloads": [
  {
   "name": "state working",
   "payload": "state=working",
   "expect": "working"
  },
  {
   "name": "state blocked",
   "payload": "state=blocked",
   "expect": "blocked"
  },
  {
   "name": "state error",
   "payload": "state=error",
   "expect": "error"
  },
  {
   "name": "state done",
   "payload": "state=done",
   "expect": "done"
  },
  {
   "name": "state idle",
   "payload": "state=idle",
   "expect": "idle"
  },
  {
   "name": "clear",
   "payload": "state=clear",
   "expect": "clear"
  },
  {
   "name": "empty",
   "payload": "",
   "expect": null
  },
  {
   "name": "no state field",
   "payload": "title=x",
   "expect": null
  },
  {
   "name": "unknown state",
   "payload": "state=busy",
   "expect": null
  },
  {
   "name": "uppercase value",
   "payload": "state=Working",
   "expect": null
  },
  {
   "name": "uppercase key",
   "payload": "STATE=working",
   "expect": null
  },
  {
   "name": "mixed case key",
   "payload": "State=working",
   "expect": null
  },
  {
   "name": "duplicate state",
   "payload": "state=working:state=working",
   "expect": null
  },
  {
   "name": "empty field",
   "payload": "state=working:",
   "expect": null
  },
  {
   "name": "missing equals",
   "payload": "state=working:title",
   "expect": null
  },
  {
   "name": "empty key",
   "payload": "=x:state=working",
   "expect": null
  },
  {
   "name": "query key",
   "payload": "state?=working",
   "expect": null
  },
  {
   "name": "query value",
   "payload": "state=?",
   "expect": null
  },
  {
   "name": "query in other key",
   "payload": "title?=x:state=working",
   "expect": null
  },
  {
   "name": "id field",
   "payload": "id=7:state=working",
   "expect": null
  },
  {
   "name": "ID field case folded",
   "payload": "ID=7:state=working",
   "expect": null
  },
  {
   "name": "extra equals belong to value",
   "payload": "title=a=b:state=done",
   "expect": "done"
  },
  {
   "name": "other fields ignored",
   "payload": "app=claude:progress=50:state=idle",
   "expect": "idle"
  },
  {
   "name": "state first then fields",
   "payload": "state=error:msg=hola mundo",
   "expect": "error"
  },
  {
   "name": "unicode title",
   "payload": "title=lobo 🐺:state=working",
   "expect": "working"
  },
  {
   "name": "c1 rejects",
   "payload": "title=:state=working",
   "expect": null
  },
  {
   "name": "del rejects",
   "payload": "title=:state=working",
   "expect": null
  },
  {
   "name": "tab rejects",
   "payload": "title=a\tb:state=working",
   "expect": null
  },
  {
   "name": "1024 bytes accepted",
   "payload": "state=working:",
   "expect": "working"
  },
  {
   "name": "1025 bytes rejected",
   "payload": "state=working:",
   "expect": null
  },
  {
   "name": "multibyte over budget rejected",
   "payload": "state=working:t=ééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééééé",
   "expect": null
  },
  {
   "name": "invalid utf-8 skipped",
   "payloadBase64": "c3RhdGU9d29ya2luZzp0Pf8=",
   "expect": "working"
  }
 ],
 "streams": [
  {
   "name": "bel-terminated status",
   "note": "",
   "input": "G103NTAxO3N0YXRlPXdvcmtpbmcH",
   "expect": [
    {
     "kind": "state",
     "state": "working",
     "at": 20
    }
   ]
  },
  {
   "name": "st-terminated status completes at ESC",
   "note": "ESC ends the OSC successfully (xterm OSC_END); the following backslash completes ST.",
   "input": "G103NTAxO3N0YXRlPWRvbmUbXA==",
   "expect": [
    {
     "kind": "state",
     "state": "done",
     "at": 17
    }
   ]
  },
  {
   "name": "title and message fields are ignored",
   "note": "",
   "input": "G103NTAxO3N0YXRlPWJsb2NrZWQ6dGl0bGU9U0VOVElORUwtVElUTEU6bXNnPVNFTlRJTkVMLU1TRwc=",
   "expect": [
    {
     "kind": "state",
     "state": "blocked",
     "at": 58
    }
   ]
  },
  {
   "name": "clear",
   "note": "",
   "input": "G103NTAxO3N0YXRlPWNsZWFyBw==",
   "expect": [
    {
     "kind": "clear",
     "at": 18
    }
   ]
  },
  {
   "name": "plain bell in text",
   "note": "",
   "input": "aGVsbG8Hd29ybGQ=",
   "expect": [
    {
     "kind": "bell",
     "at": 5
    }
   ]
  },
  {
   "name": "two statuses in one chunk",
   "note": "",
   "input": "G103NTAxO3N0YXRlPXdvcmtpbmcHdGV4dBtdNzUwMTtzdGF0ZT1pZGxlG1w=",
   "expect": [
    {
     "kind": "state",
     "state": "working",
     "at": 20
    },
    {
     "kind": "state",
     "state": "idle",
     "at": 42
    }
   ]
  },
  {
   "name": "esc inside osc ends it and starts an escape",
   "note": "ESC terminates the OSC like xterm does; '[31m' is then a CSI and the BEL rings.",
   "input": "G103NTAxO3N0YXRlPXdvcmtpbmcbWzMxbQc=",
   "expect": [
    {
     "kind": "state",
     "state": "working",
     "at": 20
    },
    {
     "kind": "bell",
     "at": 25
    }
   ]
  },
  {
   "name": "dcs containing ]7501 is ignored",
   "note": "BEL inside DCS is ignored; the DCS ends at ESC \\.",
   "input": "G1BxXTc1MDE7c3RhdGU9d29ya2luZwcjMDsyOzA7MDswG1wH",
   "expect": [
    {
     "kind": "bell",
     "at": 35
    }
   ]
  },
  {
   "name": "apc containing ]7501 is ignored",
   "note": "",
   "input": "G19dNzUwMTtzdGF0ZT1lcnJvcgcbXGFmdGVy",
   "expect": []
  },
  {
   "name": "sos and pm are ignored",
   "note": "",
   "input": "G1hdOTtub3RlBxtcG15dOTtub3RlBxtc",
   "expect": []
  },
  {
   "name": "can aborts osc",
   "note": "",
   "input": "G103NTAxO3N0YXRlPXdvcmtpbmcYBw==",
   "expect": [
    {
     "kind": "bell",
     "at": 21
    }
   ]
  },
  {
   "name": "sub aborts osc",
   "note": "",
   "input": "G105O2hlbGxvGnRleHQ=",
   "expect": []
  },
  {
   "name": "can aborts dcs",
   "note": "",
   "input": "G1AxJHIYBw==",
   "expect": [
    {
     "kind": "bell",
     "at": 6
    }
   ]
  },
  {
   "name": "oversize status is discarded whole",
   "note": "Payload over 1024 bytes: rejected without examining it; the next sequence still works.",
   "input": "",
   "expect": [
    {
     "kind": "state",
     "state": "idle",
     "at": 1145
    }
   ]
  },
  {
   "name": "exactly 1024 byte payload is accepted",
   "note": "",
   "input": "",
   "expect": [
    {
     "kind": "state",
     "state": "working",
     "at": 1031
    }
   ]
  },
  {
   "name": "oversize notification is discarded",
   "note": "Divergence: xterm would notify; the runner caps every tracked OSC at 1024 bytes.",
   "input": "",
   "expect": []
  },
  {
   "name": "osc 9;4 progress is ignored",
   "note": "",
   "input": "G105OzQ7MTs1MAc=",
   "expect": []
  },
  {
   "name": "osc 9 numeric subprotocol is ignored",
   "note": "",
   "input": "G105OzEyO3gH",
   "expect": []
  },
  {
   "name": "osc 9 message notifies",
   "note": "",
   "input": "G105O0J1aWxkIGZpbmlzaGVkBw==",
   "expect": [
    {
     "kind": "notify",
     "at": 18
    }
   ]
  },
  {
   "name": "osc 9 without payload notifies",
   "note": "xterm dispatches an identifier without ';' with an empty payload.",
   "input": "G105Bw==",
   "expect": [
    {
     "kind": "notify",
     "at": 3
    }
   ]
  },
  {
   "name": "osc 777 without notify is ignored",
   "note": "",
   "input": "G103Nzc7b3RoZXI7eAc=",
   "expect": []
  },
  {
   "name": "osc 777 notify notifies",
   "note": "",
   "input": "G103Nzc7bm90aWZ5O1RpdGxlO0JvZHkbXA==",
   "expect": [
    {
     "kind": "notify",
     "at": 23
    }
   ]
  },
  {
   "name": "unknown osc is ignored",
   "note": "",
   "input": "G10wO3dpbmRvdyB0aXRsZQcbXTg7O2h0dHBzOi8vZXhhbXBsZS5pbnZhbGlkG1w=",
   "expect": []
  },
  {
   "name": "non numeric identifier aborts",
   "note": "",
   "input": "G11hNzUwMTtzdGF0ZT13b3JraW5nBw==",
   "expect": []
  },
  {
   "name": "leading zeros in identifier",
   "note": "xterm parses the identifier as a number.",
   "input": "G10wNzUwMTtzdGF0ZT1pZGxlBw==",
   "expect": [
    {
     "kind": "state",
     "state": "idle",
     "at": 18
    }
   ]
  },
  {
   "name": "c0 inside payload is dropped",
   "note": "",
   "input": "G103NTAxO3N0YXRlPXdvAXJrEGluZwc=",
   "expect": [
    {
     "kind": "state",
     "state": "working",
     "at": 22
    }
   ]
  },
  {
   "name": "del inside payload rejects",
   "note": "",
   "input": "G103NTAxO3N0YXRlPXdvcmtpbmd/Bw==",
   "expect": []
  },
  {
   "name": "bel inside csi rings",
   "note": "",
   "input": "G1szB20=",
   "expect": [
    {
     "kind": "bell",
     "at": 3
    }
   ]
  },
  {
   "name": "bel inside escape intermediate rings",
   "note": "",
   "input": "GygHQg==",
   "expect": [
    {
     "kind": "bell",
     "at": 2
    }
   ]
  },
  {
   "name": "raw c1 bytes are ignored",
   "note": "0x9D is not an OSC introducer here: it is also a UTF-8 continuation byte.",
   "input": "nTc1MDE7c3RhdGU9d29ya2luZweckJs=",
   "expect": [
    {
     "kind": "bell",
     "at": 19
    }
   ]
  },
  {
   "name": "invalid utf-8 does not break the state",
   "note": "",
   "input": "//7DG103NTAxO3N0YXRlPWlkbGUH",
   "expect": [
